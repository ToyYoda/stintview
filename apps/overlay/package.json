{
  "name": "@stintview/overlay",
  "productName": "StintView",
  "version": "0.2.0",
  "description": "StintView – Team-Telemetrie für iRacing (Outcast Endurance)",
  "author": "Outcast Endurance",
  "private": true,
  "type": "module",
  "main": "electron/app.cjs",
  "scripts": {
    "web": "vite",
    "bundle": "node scripts/bundle.mjs",
    "build": "vite build && node scripts/bundle.mjs",
    "dev": "node scripts/bundle.mjs && node electron/dev.mjs",
    "start": "vite build && node scripts/bundle.mjs && electron .",
    "dist": "vite build && node scripts/bundle.mjs && electron-builder --win --publish never",
    "release": "vite build && node scripts/bundle.mjs && electron-builder --win --publish always",
    "typecheck": "tsc -p .",
    "dist:backseat": "vite build && node scripts/bundle.mjs && electron-builder --win --publish never --config electron-builder.backseat.yml"
  },
  "dependencies": {
    "electron-updater": "^6",
    "flag-icons": "^7",
    "koffi": "^2.9.0"
  },
  "devDependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@stintview/planner": "workspace:*",
    "@stintview/protocol": "workspace:*",
    "@stintview/telemetry": "workspace:*",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25",
    "esbuild": "^0.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simple-icons": "16.32.0",
    "vite": "^5.4.11"
  }
}

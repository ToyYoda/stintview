{
  "name": "stintview",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "app": "pnpm --filter @stintview/overlay dev",
    "app:web": "pnpm --filter @stintview/overlay web",
    "dist": "pnpm --filter @stintview/overlay dist",
    "relay": "pnpm --filter @stintview/server start",
    "relay:dev": "pnpm --filter @stintview/server dev",
    "recorder": "pnpm --filter @stintview/recorder start",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
